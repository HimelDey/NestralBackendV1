{
  "info": {
    "name": "Nestral Backend - Postman",
    "_postman_id": "nestral-backend-collection",
    "description": "Collection for Nestral backend API (import into Postman). Update `baseUrl` and `accessToken` variables as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh (protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<refresh-token-here>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "List Properties",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties"
              ]
            }
          }
        },
        {
          "name": "Create Property (form-data)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Test Property",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Sample description",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties"
              ]
            }
          }
        },
        {
          "name": "Get Property by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                ":id"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Inspections",
      "item": [
        {
          "name": "List Inspections",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inspections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inspections"
              ]
            }
          }
        },
        {
          "name": "Create Inspection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": \"<property-id>\",\n  \"date\": \"2026-08-15T10:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inspections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inspections"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Layouts",
      "item": [
        {
          "name": "Get Property Layout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/layouts/:propertyId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "layouts",
                ":propertyId"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Elements",
      "item": [
        {
          "name": "Get Elements by Property",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/:propertyId/elements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                ":propertyId",
                "elements"
              ]
            }
          }
        },
        {
          "name": "Add Element to Space (form-data)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Window",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/spaces/:spaceId/elements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "spaces",
                ":spaceId",
                "elements"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Spaces",
      "item": [
        {
          "name": "Create Space",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Living Room\",\n  \"layoutId\": \"<layout-id>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties/:propertyId/spaces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                ":propertyId",
                "spaces"
              ]
            }
          }
        }
      ]
    }
  ]
}
